{
  "abi": "sysv64",
  "arch": "x86_64",
  "os": "none",
  "llvm-target": "x86_64-none-none",
  "target-pointer-width": 64,
  "vendor": {
    "name": "nexos"
  },
  "cpu": {
    "name": "x86_64",
    "llvm": { "target": "x86_64-none-none" },
    "gcc": { "target": "x86_64-none-none" }
  },
  "data-layout": {
    "endian": "little",
    "pointer-size": 8,
    "size-size": 8,
    "align-max": 16,
    "align-of": {
      "i8": 1,
      "i16": 2,
      "i32": 4,
      "i64": 8,
      "f32": 4,
      "f64": 8,
      "pointer": 8
    }
  },
  "linker": {
    "flags": ["-nostdlib", "-static", "-Ttext=0x100000", "--no-eh"]
  }
}