# Looscid app manifest (format: docs/APPS.md)
id = clock
name = Clock
version = 1.0
category = Utilities
size_kb = 10
kind = native
entry = clock
preinstalled = yes
removable = yes
aliases = timer, stopwatch, alarm
summary = Time, timer, stopwatch and alarm with a chime.
description = Tells the time, counts down a timer, runs a stopwatch with laps, and rings an alarm at a set time. Every countdown step is said in words.
keys = t time, timer 30, timer 5m, sw stopwatch, alarm 7:30, h help, q quit
