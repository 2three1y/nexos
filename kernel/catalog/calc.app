# NexOS app manifest (format: docs/APPS.md)
id = calc
name = Calculator
version = 1.0
category = Utilities
size_kb = 8
kind = native
entry = calc
preinstalled = yes
removable = yes
aliases = calculator, math
summary = Type a sum like 12 * (3 + 4) and hear the answer.
description = A line calculator. Add, subtract, multiply, divide, powers, remainders, brackets, square roots and pi. ans is the last answer.
keys = type a sum and press Enter, h help, q quit
