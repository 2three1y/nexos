# Looscid app manifest (format: docs/APPS.md)
id = notes
name = Notes
version = 1.0
category = Productivity
size_kb = 9
kind = native
entry = notes
preinstalled = yes
removable = yes
aliases = note, notepad
summary = Write, read and delete short notes.
description = A simple notes app. Each note has a title and text and is saved as a file in the notes folder, so the shell can read it too.
keys = n new note, l list, r 2 read note 2, d 2 delete note 2, h help, q quit
